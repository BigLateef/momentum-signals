# --- Database (Neon or Supabase — auto-detected from DATABASE_URL) ---
# The app works against either provider with no code changes. Detection is
# automatic: a *.neon.tech host uses Neon's fetch-based HTTP driver
# (drizzle-orm/neon-http, no persistent connection — ideal for serverless);
# any other host (Supabase, Railway, RDS, self-hosted Postgres, etc.) uses a
# real TCP connection via postgres.js instead. Override the guess with
# DB_DRIVER=neon or DB_DRIVER=postgres if you're ever on a host this can't
# infer correctly.
#
# Neon: get this from your Neon project dashboard > Connection Details
# (use the pooled "-pooler" connection string).
#   DATABASE_URL=postgresql://neondb_owner:AbCd1234EfGh@ep-cool-forest-12345678-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Supabase: Project Settings > Database > Connection string > URI. Pick
# "Transaction pooler" (port 6543), NOT "Direct connection" — direct
# connections aren't pooled and will exhaust Postgres's connection limit
# under real serverless traffic (each function invocation opens a fresh
# connection). "Session pooler" also works if you're on an IPv4-only network
# and the transaction pooler isn't reachable.
#   DATABASE_URL=postgresql://postgres.abcdefghijklmnop:YourPassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://neondb_owner:AbCd1234EfGh@ep-cool-forest-12345678-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional: force the driver instead of auto-detecting from DATABASE_URL's
# hostname. Leave unset in the normal case.
DB_DRIVER=

# --- Session signing ---
# Generate with: openssl rand -base64 32
SESSION_SECRET=8f3k29dLxQpZ7vN1mR4wYtB6cJ0aU5eH2sD9gK3fL7pQ=

# --- Upstash Redis (rate limiting) ---
# From your Upstash Redis dashboard > REST API
UPSTASH_REDIS_REST_URL=https://us1-example-12345.upstash.io
UPSTASH_REDIS_REST_TOKEN=AaAaBbBbCcCcDdDdEeEeFfFfGgGgHhHhIiIiJjJj

# --- External trigger route ---
# Used by cron-job.org or your own scanner to POST new signals to /api/triggers/signal
# Generate with: openssl rand -hex 24
CRON_API_KEY=7a1f9c3e2b8d4f6a0c5e9b1d3f7a2c8e4b6d0f9a1c3e5b7d

# --- Vercel Cron (optional, only if using vercel.json's built-in cron instead of cron-job.org) ---
# Vercel auto-attaches this as "Authorization: Bearer <CRON_SECRET>" to scheduled requests.
# Set this to the EXACT SAME value as CRON_API_KEY above so both auth paths validate identically.
CRON_SECRET=7a1f9c3e2b8d4f6a0c5e9b1d3f7a2c8e4b6d0f9a1c3e5b7d

# NOTE: do NOT set NODE_ENV in Vercel's dashboard — Vercel sets it automatically
# per environment (production/preview/development). Manually adding it there
# causes a harmless but confusing "NODE_ENV was incorrectly set" build warning.
# Only relevant locally, and next/dev already handles it — no line needed here.

# --- Optional: Discord alerts for HIGH-confidence signals ---
# Create an incoming webhook in your Discord server: Server Settings > Integrations > Webhooks
# Leave unset to disable — alerts are simply skipped, nothing breaks.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/AbCdEfGhIjKlMnOpQrStUvWxYz

# --- Optional: Mistral AI for readable auto-signal reasons ---
# Get a key at https://console.mistral.ai (free tier available)
# Leave unset and the scanner just uses its templated numeric reason instead.
MISTRAL_API_KEY=abcdefghijklmnopqrstuvwxyz123456

# --- Optional: KOL wallet holder-checking (one key per chain you want checked) ---
# All have free tiers. Leave any of these unset to skip that chain's KOL check silently.
# Etherscan: https://etherscan.io/apis
ETHERSCAN_API_KEY=ABC123DEF456GHI789JKL012MNO345PQR6
# BscScan: https://bscscan.com/apis
BSCSCAN_API_KEY=ABC123DEF456GHI789JKL012MNO345PQR6
# BaseScan: https://basescan.org/apis
BASESCAN_API_KEY=ABC123DEF456GHI789JKL012MNO345PQR6
# Solscan Pro API: https://pro-api.solscan.io (free tier available; the old
# free public API was deprecated, this is the current replacement)
SOLSCAN_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.key

# ============================================================
# Anti-rug / token safety
# ============================================================
# No keys required — RugCheck.xyz (Solana) and GoPlus Security (EVM chains)
# both have free public endpoints used automatically. Nothing to configure
# here; this section exists purely as documentation.

# ============================================================
# Automated trading (burner wallet)
# ============================================================
# The burner wallet's private key. NEVER commit this, never paste it into
# chat, and use a wallet funded with ONLY what you're willing to risk —
# this key can sign and broadcast real transactions if AUTO_TRADE_ENABLED=true
# and AUTO_TRADE_DRY_RUN=false.
# Solana: base58-encoded secret key (the format Phantom/Solflare export).
# BNB: raw hex private key, with or without the 0x prefix.
AUTO_TRADE_WALLET_PRIVATE_KEY=

# Optional: your own BNB RPC endpoint (defaults to the public BSC dataseed,
# which is rate-limited and fine for testing, not for serious volume).
BNB_RPC_URL=
# Optional: your own Solana RPC endpoint (defaults to the public mainnet-beta
# endpoint, which is rate-limited).
SOLANA_RPC_URL=

# --- Master switches — BOTH must be explicitly true for a trade to broadcast ---
AUTO_TRADE_ENABLED=false
AUTO_TRADE_DRY_RUN=true

# --- Independent buy/sell controls ---
AUTO_TRADE_BUY_ENABLED=true
AUTO_TRADE_SELL_ENABLED=false

# --- What to trade ---
AUTO_TRADE_CHAIN=SOLANA
AUTO_TRADE_BASE_CURRENCY=SOL
AUTO_TRADE_CONFIDENCE=MEDIUM
AUTO_TRADE_MOMENTUM_SCORE=8
AUTO_TRADE_MAX_SIGNAL_AGE_SECONDS=60
AUTO_TRADE_MAX_ENTRY_DEVIATION_PCT=5

# --- Liquidity / slippage guards (each can be toggled independently) ---
AUTO_TRADE_ENFORCE_LIQUIDITY=true
AUTO_TRADE_MIN_LIQUIDITY_USD=25000
AUTO_TRADE_ENFORCE_SLIPPAGE=true
AUTO_TRADE_MAX_SLIPPAGE_BPS=500

# --- Position sizing ---
AUTO_TRADE_AMOUNT_SOL=0.05
AUTO_TRADE_AMOUNT_USDC=10

# --- Daily circuit breakers ---
AUTO_TRADE_MAX_DAILY_TRADES=10
AUTO_TRADE_MAX_DAILY_LOSS_USD=50
AUTO_TRADE_DEDUPE_WINDOW_SECONDS=3600

# ============================================================
# Unified monitoring scheduler
# ============================================================
# When true, /api/cron/monitoring-scheduler becomes the authoritative
# production job and the legacy /api/cron/scan, /api/cron/update-prices,
# and /api/cron/market-cycle routes no-op (pass ?force=true to any of them
# to run standalone for manual testing). Point ONE cron-job.org schedule at
# /api/cron/monitoring-scheduler once you flip this on.
MONITORING_SCHEDULER_ENABLED=false
MONITORING_SCHEDULER_INTERVAL_MINUTES=5
MONITORING_SCHEDULER_MAX_RUNTIME_SECONDS=240
MONITORING_SCHEDULER_SEND_SUMMARY_ALERTS=true
